<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Retour dans l'app après la connexion Google. Google refuse de
                 s'afficher dans la WebView embarquée de l'app (erreur
                 disallowed_useragent) : le consentement se donne forcément
                 dans un vrai navigateur, et sans ce chemin de retour, la page
                 de confirmation n'avait que le site web à proposer — Raphaël
                 se retrouvait dans le navigateur au lieu de revenir dans
                 l'app installée. Schéma personnalisé plutôt qu'App Links
                 HTTPS : ceux-ci demandent d'héberger un fichier de
                 vérification à la RACINE du domaine (rnab26.github.io), qui
                 n'appartient pas à ce dépôt (le site est publié sous
                 /Jarvis-assistant/). Le schéma est celui de l'application
                 elle-même (com.raphael.jarvis), donc garanti unique sur
                 l'appareil. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.raphael.jarvis" android:host="oauth-retour" />
            </intent-filter>
        </activity>

        <!-- Déclenché par l'appui long sur le bouton d'alimentation (rôle
             assistant d'Android), comme Perplexity : une fenêtre en
             surcouche, pas l'app entière. Activité séparée de MainActivity
             plutôt qu'un mode particulier de celle-ci, pour garder une vraie
             fenêtre translucide et ancrée en bas (voir Theme.Jarvis.Assist
             dans styles.xml) sans changer le comportement du lancement
             normal. singleInstance + taskAffinity vide : un deuxième appui
             pendant qu'elle est déjà ouverte la ramène au premier plan au
             lieu d'en empiler une deuxième, et elle n'apparaît jamais dans
             les tâches récentes à côté de l'app principale. -->
        <activity
            android:name=".AssistOverlayActivity"
            android:theme="@style/Theme.Jarvis.Assist"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Ce qui rend Jarvis CHOISISSABLE comme assistant du telephone
             (chantier 7b8e68a7). Le 5 sept. on avait declare une activite
             exportee repondant a ACTION_ASSIST : c'est l'une des deux
             branches qu'AOSP accepte, mais la liste de Samsung ne montre que
             l'autre — un vrai VoiceInteractionService. Constate par Raphael
             le 6 sept. au matin, captures a l'appui : il suit le chemin
             jusqu'au bout et Jarvis n'y est pas.

             La permission BIND_VOICE_INTERACTION n'est PAS decorative :
             VoiceInteractionServiceInfo compare `si.permission` a cette
             chaine exacte et refuse tout le service sinon, en silence. Les
             deux services sont exportes parce que c'est le systeme qui s'y
             lie, et cette permission de signature est ce qui les protege. -->
        <service
            android:name=".JarvisVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".JarvisVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- Un moteur de reconnaissance qui ne reconnait rien : Android
             refuse le VoiceInteractionService dont le XML ne declare pas de
             recognitionService (« No recognitionService specified »), et
             Jarvis disparait de la liste sans le moindre message. Jarvis
             ecoute par le plugin, qui vise le moteur de Google. -->
        <service
            android:name=".JarvisRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- La bulle flottante (chantier f5621562). Service de premier plan
             parce qu'une vue posée par WindowManager vit dans le processus de
             l'app : sans lui, Android tue ce processus en arriere-plan et la
             bulle disparait au bout de quelques minutes, en silence.
             foregroundServiceType "specialUse" : aucun des types prevus par
             Android (localisation, lecture de media, appel) ne decrit une
             pastille posee a l'ecran ; la propriete en dessous dit lequel
             c'est, comme Android l'exige depuis la version 14. -->
        <service
            android:name=".BulleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pastille flottante d assistance, affichee a la demande de l utilisateur" />
        </service>

        <!-- Le service qui permet a Jarvis d'appuyer sur l'ecran a la place de
             Raphael (chantiers 3f3ad20b et ed32cbcc). Sa demande du 6 sept.
             2026 : « il faut aussi que ca puisse faire une activation de
             clics tout simplement sur le telephone a la demande orale, et ca
             ce n'est pas la pour n'importe quoi, pas que pour WhatsApp. »

             BIND_ACCESSIBILITY_SERVICE n'est pas decorative : Android refuse
             de se lier a un service d'accessibilite qui ne la declare pas, et
             il n'apparait alors nulle part dans les reglages. Exporte parce
             que c'est le systeme qui s'y lie, et cette permission de
             signature est ce qui le protege.

             Il ne s'active PAS a l'installation : c'est un acces special que
             seul Raphael peut accorder, une fois, dans ses reglages Android.
             La carte « Appuyer sur l'ecran a ta place » de Parametres lit
             l'etat REEL et ouvre le bon ecran. -->
        <service
            android:name=".JarvisAccessibiliteService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibilite" />
        </service>

        <receiver android:name=".JarvisWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/jarvis_widget_info" />
        </receiver>

        <!-- Second widget : le cœur seul, on appuie, Jarvis écoute. Un
             fournisseur distinct parce que la taille minimale et l'aperçu se
             déclarent dans le XML, pas à l'exécution : un widget unique à deux
             modes garderait le plancher du mode « tâches ». -->
        <receiver android:name=".JarvisCoreWidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/jarvis_widget_core_info" />
        </receiver>

        <!-- Rappels de lieu par géolocalisation (option, désactivée par
             défaut) : reçoit les transitions ENTER des zones enregistrées
             via GeofencingClient et affiche une notification. -->
        <receiver android:name=".GeofenceBroadcastReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Rappels de lieu par géolocalisation (option désactivée par défaut,
         demandées seulement si l'utilisateur active la fonction dans
         Paramètres). ACCESS_BACKGROUND_LOCATION est requise séparément à
         partir d'Android 10, via un second écran système. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La bulle flottante : afficher une pastille par-dessus les autres
         applications. Accès spécial, jamais accordé par une fenêtre de
         demande — il se donne dans un écran de réglages d'Android, et
         l'interrupteur de Paramètres y renvoie. Désactivée par défaut.
         FOREGROUND_SERVICE et sa variante « usage particulier » vont avec le
         service qui tient la bulle en vie. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Mise à jour de l'app : installer l'APK téléchargé par
         ApkDownloaderPlugin, sans passer par un navigateur. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Poser une alarme ou un minuteur sans ouvrir l'app d'horloge. Seule
         permission demandée par les actions dans les autres applications :
         composer un numéro (ACTION_DIAL) et pré-remplir un message
         (ACTION_SENDTO) n'en demandent aucune, justement parce que le
         dernier geste reste celui de l'utilisateur. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Lancer un appel directement plutôt que de seulement composer le
         numéro. Choix explicite de Raphaël : un assistant qui demande une
         confirmation pour tout n'apporte rien de plus que ceux déjà intégrés
         au téléphone. Demandée à la première utilisation ; refusée, Jarvis
         se contente de composer, il n'échoue pas. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Le repertoire du telephone, en lecture seule. Demande a la premiere
         utilisation, jamais au demarrage : « rappelle ma femme a 23h22 » n a
         aucun sens si Jarvis ne voit que le carnet vide qu il tenait de son
         cote. Rien n est copie en base : la liste est lue a la demande. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Mode conversation Live (4 sept. 2026) : le micro du navigateur intégré
         (getUserMedia), pas celui du plugin de reconnaissance. Capacitor
         (BridgeWebChromeClient.onPermissionRequest) exige RECORD_AUDIO ET
         MODIFY_AUDIO_SETTINGS, et refuse la capture si l'une des deux n'est pas
         déclarée ici — c'était le « Permission denied » vu par Raphaël dans
         l'app. RECORD_AUDIO vient déjà du plugin par fusion de manifestes ;
         on la déclare quand même, pour ne pas dépendre de lui. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Depuis Android 11, une app ne voit les autres que si elle les
         déclare ici. On ne demande PAS QUERY_ALL_PACKAGES (visibilité totale
         sur l'appareil, refusée par Google Play sans justification) : on
         déclare seulement ce que Jarvis a besoin de voir — les applications
         ouvrables, et les apps capables de répondre aux actions qu'il
         propose. Sans ce bloc, la liste des apps revient vide et chaque
         intent échoue silencieusement. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- Les applications capables de PASSER l'appel, pas seulement de le
             composer : c'est parmi celles-la qu'il choisit son application
             d'appel par defaut, pour ne plus voir le selecteur
             « Terminer l'action avec… » a chaque appel. -->
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.whatsapp" />
        <!-- WhatsApp Business : sans cette ligne on ne peut pas savoir qu'elle
             est installee, donc pas la proposer au choix — et c'est elle qui
             recevait ses messages le 6 sept. 2026. -->
        <package android:name="com.whatsapp.w4b" />
    </queries>
</manifest>

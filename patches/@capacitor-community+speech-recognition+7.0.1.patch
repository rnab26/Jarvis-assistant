+     * Play Services, ou son paquet differe de celui attendu ici). */
+    private ComponentName trouverServiceGoogle() {
+        PackageManager pm = bridge.getContext().getPackageManager();
+        List<ResolveInfo> services = pm.queryIntentServices(new Intent(RecognitionService.SERVICE_INTERFACE), 0);
+        StringBuilder trouves = new StringBuilder();
+        ComponentName google = null;
+        for (ResolveInfo info : services) {
+            if (info.serviceInfo == null) continue;
+            if (trouves.length() > 0) trouves.append(",");
+            trouves.append(info.serviceInfo.packageName);
+            if ("com.google.android.googlequicksearchbox".equals(info.serviceInfo.packageName)) {
+                google = new ComponentName(info.serviceInfo.packageName, info.serviceInfo.name);
+            }
+        }
+        servicesDisponibles = trouves.length() > 0 ? trouves.toString() : "aucun";
+        return google;
+    }
